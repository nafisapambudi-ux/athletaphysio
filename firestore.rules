rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function ownsNewDocument() {
      return isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
    }

    function ownsExistingDocument() {
      return isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function keepsOwnership() {
      return ownsExistingDocument()
        && request.resource.data.ownerId == request.auth.uid;
    }

    function isValidVBTSession(data) {
      return data.loadKg is number
        && data.loadKg > 0
        && data.loadKg <= 500
        && data.reps is list
        && data.reps.size() > 0
        && data.reps.size() <= 50
        && data.meanVelocityAvg is number
        && data.meanVelocityAvg > 0
        && data.meanVelocityAvg <= 5
        && data.estimated1RM is number
        && data.estimated1RM > 0
        && data.estimated1RM <= 1000;
    }

    // User Profile (PII Protected)
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Athletes collection
    match /athletes/{athleteId} {
      allow list, get: if ownsExistingDocument();
      allow create: if isValidId(athleteId) && ownsNewDocument();
      allow update: if isValidId(athleteId) && keepsOwnership();
      allow delete: if isValidId(athleteId) && ownsExistingDocument();
    }

    // Training Sessions
    match /trainingSessions/{sessionId} {
      allow list, get: if ownsExistingDocument();
      allow create: if isValidId(sessionId) && ownsNewDocument();
      allow update: if isValidId(sessionId) && keepsOwnership();
      allow delete: if isValidId(sessionId) && ownsExistingDocument();
    }

    // Wellness Logs
    match /wellnessLogs/{logId} {
      allow list, get: if ownsExistingDocument();
      allow create: if isValidId(logId) && ownsNewDocument();
      allow update: if isValidId(logId) && keepsOwnership();
      allow delete: if isValidId(logId) && ownsExistingDocument();
    }

    // Fitness Tests
    match /fitnessTests/{testId} {
      allow list, get: if ownsExistingDocument();
      allow create: if isValidId(testId) && ownsNewDocument();
      allow update: if isValidId(testId) && keepsOwnership();
      allow delete: if isValidId(testId) && ownsExistingDocument();
    }

    // Jump Measurements
    match /jumpMeasurements/{jumpId} {
      allow list, get: if ownsExistingDocument();
      allow create: if isValidId(jumpId) && ownsNewDocument();
      allow update: if isValidId(jumpId) && keepsOwnership();
      allow delete: if isValidId(jumpId) && ownsExistingDocument();
    }

    // VBT Sessions
    match /vbtSessions/{vbtId} {
      allow list, get: if ownsExistingDocument();
      allow create: if isValidId(vbtId) && ownsNewDocument() && isValidVBTSession(request.resource.data);
      allow update: if isValidId(vbtId) && keepsOwnership() && isValidVBTSession(request.resource.data);
      allow delete: if isValidId(vbtId) && ownsExistingDocument();
    }

    // Pain Points
    match /painPoints/{painId} {
      allow list, get: if ownsExistingDocument();
      allow create: if isValidId(painId) && ownsNewDocument();
      allow update: if isValidId(painId) && keepsOwnership();
      allow delete: if isValidId(painId) && ownsExistingDocument();
    }

    // Performance Goals
    match /performanceGoals/{goalId} {
      allow list, get: if ownsExistingDocument();
      allow create: if isValidId(goalId) && ownsNewDocument();
      allow update: if isValidId(goalId) && keepsOwnership();
      allow delete: if isValidId(goalId) && ownsExistingDocument();
    }


  }
}
